<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/visual-programming-lab1">
  <bpmn:process id="Process_Repair" name="Ремонт устройства в сервисном центре" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Устройство принято"/>
    <bpmn:task id="Task_Accept" name="Принять устройство"/>
    <bpmn:task id="Task_Register" name="Зарегистрировать заявку"/>
    <bpmn:task id="Task_Diagnose" name="Провести диагностику"/>
    <bpmn:exclusiveGateway id="Gateway_Repairable" name="Ремонт возможен?"/>
    <bpmn:task id="Task_Conclusion" name="Подготовить заключение"/>
    <bpmn:task id="Task_Estimate" name="Рассчитать стоимость"/>
    <bpmn:exclusiveGateway id="Gateway_Approve" name="Клиент согласен?"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="Параллельная подготовка"/>
    <bpmn:task id="Task_Parts" name="Подготовить комплектующие"/>
    <bpmn:task id="Task_Deadline" name="Подтвердить срок ремонта"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Подготовка завершена"/>
    <bpmn:task id="Task_Repair" name="Выполнить ремонт"/>
    <bpmn:task id="Task_Test" name="Проверить работоспособность"/>
    <bpmn:task id="Task_Notify" name="Сообщить о готовности"/>
    <bpmn:task id="Task_Return" name="Выдать устройство"/>
    <bpmn:endEvent id="EndEvent_1" name="Процесс завершён"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Accept"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Accept" targetRef="Task_Register"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Register" targetRef="Task_Diagnose"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Diagnose" targetRef="Gateway_Repairable"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Repairable" targetRef="Task_Conclusion" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Conclusion" targetRef="Task_Return"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Repairable" targetRef="Task_Estimate" name="Да"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Estimate" targetRef="Gateway_Approve"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gateway_Approve" targetRef="Task_Return" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Approve" targetRef="Gateway_ParallelSplit" name="Да"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gateway_ParallelSplit" targetRef="Task_Parts"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_ParallelSplit" targetRef="Task_Deadline"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Parts" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Deadline" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ParallelJoin" targetRef="Task_Repair"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Repair" targetRef="Task_Test"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Test" targetRef="Task_Notify"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Notify" targetRef="Task_Return"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Return" targetRef="EndEvent_1"/>
  </bpmn:process>
