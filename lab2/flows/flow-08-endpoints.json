    "func": "const raw=msg.req.params.id; const id=Number(raw); const items={1:{id:1,name:\"Keyboard\"},2:{id:2,name:\"Mouse\"},3:{id:3,name:\"Monitor\"}}; msg.headers={\"Content-Type\":\"application/json; charset=utf-8\"}; if(!Number.isInteger(id)||id<=0){msg.statusCode=400;msg.payload={error:\"invalid id\",student:\"Gantsevich\"};} else if(!items[id]){msg.statusCode=404;msg.payload={error:\"item not found\",id:id};} else {msg.statusCode=200;msg.payload=items[id];} return msg;",
