      "graphCoordinates": { "x": 1900, "y": 220 },
      "blocks": [
        {
          "id": "text-fact-loading",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Получаю случайный факт из внешнего API…" }] }] }
        },
        {
          "id": "http-cat-fact",
          "type": "Webhook",
          "options": {
            "responseVariableMapping": [
