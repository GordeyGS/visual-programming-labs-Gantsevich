        {
          "id": "text-status",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Статус: {{Статус}} ✅" }] }] }
        },
        { "id": "jump-lab", "type": "Jump", "options": { "groupId": "group-menu", "blockId": "choice-menu" } }
      ]
    },
    {
      "id": "group-fact",
