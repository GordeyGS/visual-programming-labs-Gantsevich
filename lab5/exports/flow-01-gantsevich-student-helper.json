        {
          "id": "condition-group",
          "outgoingEdgeId": "edge-condition-other",
          "type": "Condition",
          "items": [
            {
              "id": "condition-group-match",
              "outgoingEdgeId": "edge-condition-match",
              "content": {
                "comparisons": [
                  {
                    "id": "comparison-group",
                    "variableId": "var-group",
                    "comparisonOperator": "Equal to",
                    "value": "СДП-ИИ-241"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "group-recognized",
      "title": "Своя группа",
      "graphCoordinates": { "x": 1100, "y": -180 },
