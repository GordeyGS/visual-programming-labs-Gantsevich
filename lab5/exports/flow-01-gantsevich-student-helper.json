          "content": { "richText": [{ "type": "p", "children": [{ "text": "Как тебя зовут?" }] }] }
        },
        {
          "id": "input-name",
          "outgoingEdgeId": "edge-welcome-profile",
          "type": "text input",
          "options": {
            "variableId": "var-name",
            "labels": { "placeholder": "Введите имя" }
          }
        }
      ]
    },
    {
      "id": "group-profile",
      "title": "Данные студента и условие",
      "graphCoordinates": { "x": 700, "y": 0 },
