          "outgoingEdgeId": "edge-recognized-menu",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Отлично, {{Имя}}! Мы из одной группы — СДП-ИИ-241 ✅" }] }] }
