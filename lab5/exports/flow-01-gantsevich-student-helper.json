            "isAdvancedConfig": true,
            "webhook": { "method": "GET", "url": "https://catfact.ninja/fact" }
          }
        },
        {
          "id": "text-fact-result",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Факт: {{Факт}}" }] }] }
        },
        { "id": "jump-fact", "type": "Jump", "options": { "groupId": "group-menu", "blockId": "choice-menu" } }
      ]
    },
    {
      "id": "group-question",
      "title": "Свой вопрос",
      "graphCoordinates": { "x": 1900, "y": 540 },
      "blocks": [
        {
          "id": "text-question",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Напиши вопрос, который нужно разобрать." }] }] }
