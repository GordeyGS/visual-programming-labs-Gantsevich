              { "type": "p", "children": [{ "text": "3. Сделать скриншоты и подготовиться к защите." }] }
            ]
          }
        },
        { "id": "jump-schedule", "type": "Jump", "options": { "groupId": "group-menu", "blockId": "choice-menu" } }
      ]
    },
    {
      "id": "group-lab",
      "title": "Подготовка лабораторной",
      "graphCoordinates": { "x": 1900, "y": -80 },
      "blocks": [
        {
          "id": "text-lab",
          "type": "text",
          "content": { "richText": [{ "type": "p", "children": [{ "text": "Для сдачи нужны рабочий бот, JSON-экспорт, скриншоты, отчёт и минимум шесть осмысленных Git-коммитов." }] }] }
        },
        {
          "id": "set-status",
